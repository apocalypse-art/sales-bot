# ─── Twitter / X API Credentials ─────────────────────────────────────────────
# Get these from: https://developer.twitter.com/en/portal/dashboard
# Create a project → App → Keys and Tokens
# Make sure the app has READ and WRITE permissions

TWITTER_APP_KEY=your_api_key_here
TWITTER_APP_SECRET=your_api_key_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_SECRET=your_access_token_secret_here


# ─── Alchemy ──────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.alchemy.com
# Create an app → Webhooks → NFT Activity → copy the Signing Key shown there

ALCHEMY_SIGNING_KEY=your_alchemy_webhook_signing_key_here

# HTTPS RPC URL for your Ethereum Mainnet Alchemy app (same account as above).
# Alchemy dashboard → your app → "API Key" / "Endpoints" → copy the HTTPS URL.
# It looks like: https://eth-mainnet.g.alchemy.com/v2/XXXXXXXXXXXXXXXX
# Used to read which marketplace a sale settled through (e.g. Manifold vs OpenSea).
# If left blank, tweets still post but omit the marketplace name.
ALCHEMY_RPC_URL=your_alchemy_eth_mainnet_https_rpc_url_here


# Optional — JSON-RPC endpoint for Shape, used to price primary sales (mints)
# on Shape. Defaults to the public https://mainnet.shape.network if left unset.
SHAPE_RPC_URL=

# ─── OpenSea API ──────────────────────────────────────────────────────────────
# Free API key from: https://docs.opensea.io/reference/api-keys
# (Click "Request API Key" — approval is usually instant)

OPENSEA_API_KEY=your_opensea_api_key_here


# ─── Server Port ─────────────────────────────────────────────────────────────
# Railway sets this automatically; you only need this for local testing.

PORT=3000

# ─── The Oversoul announcement endpoint ──────────────────────────────────────
# The Oversoul's artwork publishes to Arweave minutes to an hour AFTER the sale,
# so announcing on the mint webhook announces a placeholder. Its publish job
# calls POST /announce-sale instead, once it has verified the artwork resolves.
#
# Shared secret, also set as a GitHub Actions secret in the oversoul repo. The
# caller signs the request body with it (HMAC-SHA256, x-oversoul-signature).
# Generate one with:  openssl rand -hex 32
# If this is unset the endpoint refuses every request rather than accepting
# unauthenticated ones.
SALES_BOT_SECRET=

# Kill switch. Set to "true" to make /announce-sale refuse everything, without a
# deploy or a code change. Leave unset in normal operation.
OVERSOUL_ANNOUNCE_DISABLED=

# Rehearsal mode. Set to "true" and /announce-sale does all the real work —
# reads the price off the chain, downloads and converts the artwork — but does
# not post. The caller sees reason:"dry-run" and deliberately does NOT record
# the sale as announced, so nothing is lost. Leave unset in normal operation.
OVERSOUL_ANNOUNCE_DRY_RUN=
